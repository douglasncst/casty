{
  "name": "dcforge-lastfm",
  "version": "0.1.0",
  "private": true,
  "description": "Export a Last.fm user's most played tracks as CSV.",
  "type": "module",
  "bin": {
    "lastfm-top": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
